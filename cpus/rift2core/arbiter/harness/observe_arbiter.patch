+  cpuEvalArbiterProbe("Lsu.lu_wb_arb", lu_wb_arb.io.in.map(_.valid), lu_wb_arb.io.in.map(_.ready),
+    lu_wb_arb.io.chosen, lu_wb_arb.io.out.valid, lu_wb_arb.io.out.ready)
+  cpuEvalArbiterProbe("Lsu.irtn_arb", irtn_arb.io.in.map(_.valid), irtn_arb.io.in.map(_.ready),
