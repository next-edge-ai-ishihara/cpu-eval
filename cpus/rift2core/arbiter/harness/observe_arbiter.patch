+  def cpuEvalArbiterProbe(
+    name: String,
+    valids: Seq[Bool],
+    readys: Seq[Bool],
+    chosen: UInt,
+    outValid: Bool,
+    outReady: Bool
+  ): Unit = {
+    val n = valids.length
+    val goldenChosen = WireDefault((n - 1).U(chosen.getWidth.W))
+    for (i <- n - 2 to 0 by -1) { when(valids(i)) { goldenChosen := i.U } }
+    val goldenOutValid = valids.reduce(_ || _)
+    val transferWrong = (0 until n).map { i =>
+      (valids(i) && (goldenChosen === i.U) && outReady) =/= (valids(i) && readys(i))
+    }.reduce(_ || _)
+    val wrong =
+      (outValid =/= goldenOutValid) || transferWrong ||
+      (goldenOutValid && (chosen =/= goldenChosen))
+    val mismatchCount = RegInit(0.U(8.W))
+    when(wrong && mismatchCount < 64.U) {
+      mismatchCount := mismatchCount + 1.U
+      printf(
+        s"CPU_EVAL_OBSERVATION_MISMATCH Arbiter $name valids=%d readys=%d chosen=%d goldenChosen=%d outValid=%d goldenOutValid=%d outReady=%d\n",
+        VecInit(valids).asUInt, VecInit(readys).asUInt, chosen, goldenChosen,
+        outValid, goldenOutValid, outReady
+      )
+    }
+    val contention = PopCount(VecInit(valids).asUInt) > 1.U
+    val contentionCount = RegInit(0.U(8.W))
+    when(contention && contentionCount < 8.U) {
+      contentionCount := contentionCount + 1.U
+      printf(
+        s"CPU_EVAL_ARBITER_CONTENTION $name valids=%d outReady=%d\n",
+        VecInit(valids).asUInt, outReady
+      )
+    }
+  }
+
