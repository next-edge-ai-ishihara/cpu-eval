+      printf(p"CPU_EVAL_DECODE16 instruction=0x${Hexadecimal(cpuEvalInstruction)} fld=${decoded.lsuIsa.fld} fsd=${decoded.lsuIsa.fsd} access=${decoded.privil_isa.is_access_fault} paging=${decoded.privil_isa.is_paging_fault} ld=${decoded.lsuIsa.ld} sd=${decoded.lsuIsa.sd}\n")
