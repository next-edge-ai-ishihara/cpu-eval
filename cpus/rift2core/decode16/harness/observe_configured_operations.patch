   val tageFifo = Module(new MultiPortFifo( Vec(6, new TageTableResp_Bundle ), aw = (if(!isMinArea) 4 else 1), in = 1, out = rnChn, flow = true ) )
 
+
+  if (fpuNum == 0) {
+    val cpuEvalIndex = RegInit(0.U(4.W))
+    val cpuEvalPatterns = VecInit(Seq("h2000".U(16.W), "ha000".U(16.W), "h2082".U(16.W), "ha006".U(16.W),
+      "h9c41".U(16.W), "h9c45".U(16.W), "h6000".U(16.W), "he000".U(16.W)))
+    val cpuEvalInstruction = cpuEvalPatterns(cpuEvalIndex(2, 0))
