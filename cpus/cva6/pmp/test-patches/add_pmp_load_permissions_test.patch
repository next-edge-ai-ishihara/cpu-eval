diff --git a/verif/tests/custom/pmp/cpu_eval_pmp_load_permissions_test.S b/verif/tests/custom/pmp/cpu_eval_pmp_load_permissions_test.S
new file mode 100644
--- /dev/null
+++ b/verif/tests/custom/pmp/cpu_eval_pmp_load_permissions_test.S
@@ -0,0 +1,103 @@
+#include "encoding.h"
+
+  .equ MSTATUS_MPP_S,           (PRV_S << 11)
+  .equ CPU_EVAL_LOAD_FAULT,  5
+  .equ CPU_EVAL_S_ECALL,     9
+  .equ PMP_RWX_TOR,             (PMP_L | PMP_TOR | PMP_R | PMP_W | PMP_X)
+  .equ PMP_R_TOR,               (PMP_L | PMP_TOR | PMP_R)
+  .equ PMP_NONE_TOR,            (PMP_L | PMP_TOR)
+  .equ SECRET,                  0x13579bdf
+
+  .section .text
+  .align 2
+  .globl main
+main:
+  la      t0, trap_handler
+  csrw    mtvec, t0
+  csrw    medeleg, zero
+  csrw    mideleg, zero
+  csrw    satp, zero
+  sfence.vma
+
+  csrw    pmpcfg0, zero
+
+  # Entry 0 permits the program and runtime below cpu_eval_target.
+  la      t0, cpu_eval_target
+  srli    t0, t0, PMP_SHIFT
+  csrw    pmpaddr0, t0
+
+  # Entry 1 permits reading cpu_eval_target but denies writing it.
+  la      t0, cpu_eval_target_end
+  srli    t0, t0, PMP_SHIFT
+  csrw    pmpaddr1, t0
+
+  # Entry 2 denies every access to cpu_eval_denied_target.
+  la      t0, cpu_eval_denied_target_end
+  srli    t0, t0, PMP_SHIFT
+  csrw    pmpaddr2, t0
+
+  li      t0, (PMP_NONE_TOR << 16) | (PMP_R_TOR << 8) | PMP_RWX_TOR
+  csrw    pmpcfg0, t0
+  fence
+
+  la      t0, supervisor_test
+  li      t1, MSTATUS_MPP
+  csrc    mstatus, t1
+  li      t1, MSTATUS_MPP_S
+  csrs    mstatus, t1
+  csrw    mepc, t0
+  mret
+
+supervisor_test:
+  la      t0, cpu_eval_target
+  lw      t1, 0(t0)
+  li      t2, SECRET
+  bne     t1, t2, supervisor_fail
+
+  li      s0, 0
+  la      t0, cpu_eval_denied_target
+  lw      t1, 0(t0)
+
+  # The load-fault handler records one in s0 and skips the denied load.
+  li      t1, 1
+  bne     s0, t1, supervisor_fail
+
+  li      a0, 0
+  ecall
+
+supervisor_fail:
+  li      a0, 1
+  ecall
+
+  .align 2
+trap_handler:
+  csrr    t0, mcause
+  li      t1, CPU_EVAL_LOAD_FAULT
+  beq     t0, t1, handle_load_fault
+  li      t1, CPU_EVAL_S_ECALL
+  beq     t0, t1, finish
+  li      a0, 1
+  j       finish
+
+handle_load_fault:
+  li      s0, 1
+  csrr    t0, mepc
+  addi    t0, t0, 4
+  csrw    mepc, t0
+  mret
+
+finish:
+  csrw    pmpcfg0, zero
+  fence
+  jal     exit
+
+  .align 4
+cpu_eval_target:
+  .word   SECRET
+  .align 4
+cpu_eval_target_end:
+cpu_eval_denied_target:
+  .word   SECRET
+  .align 4
+cpu_eval_denied_target_end:
+  .word   0
