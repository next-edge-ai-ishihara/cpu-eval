+#include "model_test.h"
+#include "arch_test.h"
+RVTEST_ISA("RV32I")
+
+.section .text.init
+.globl rvtest_entry_point
+rvtest_entry_point:
+RVMODEL_BOOT
+RVTEST_CODE_BEGIN
+    li a0, 5
+    li a1, 7
+    .insn r CUSTOM_3, 0x1, 0x0, a2, a0, a1
+    addi a3, a2, 1
+RVTEST_CODE_END
+RVMODEL_HALT
+
+RVTEST_DATA_BEGIN
+RVTEST_DATA_END
+
+RVMODEL_DATA_BEGIN
+rvtest_sig_begin:
+sig_begin_canary:
+CANARY;
+#ifdef rvtest_mtrap_routine
+tsig_begin_canary:
+CANARY;
+mtrap_sigptr:
+    .fill 64*(XLEN/32),4,0xdeadbeef
+tsig_end_canary:
+CANARY;
+#endif
+#ifdef rvtest_gpr_save
+gpr_save:
+    .fill 32*(XLEN/32),4,0xdeadbeef
+#endif
+sig_end_canary:
+CANARY;
+rvtest_sig_end:
+RVMODEL_DATA_END

