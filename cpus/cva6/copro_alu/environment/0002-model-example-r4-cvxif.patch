+  static reg_t r4_arithmetic(processor_t* p, insn_t insn, reg_t pc)
+  {
+    uint32_t bits = insn.bits();
+    reg_t lhs = READ_REG((bits >> 15) & 0x1f);
+    reg_t rhs = READ_REG((bits >> 20) & 0x1f);
+    reg_t result;
+    switch (bits & 0x7f)
+    {
+      case 0x43:
+        result = lhs + rhs;
+        break;
+      case 0x47:
+        result = lhs - rhs;
+        break;
+      case 0x4f:
+        result = ~(lhs + rhs);
+        break;
+      case 0x4b:
+        result = ~(lhs - rhs);
+        break;
+      default:
+        return ::illegal_instruction(p, insn, pc);
+    }
+    WRITE_REG((bits >> 7) & 0x1f, result);
+    return pc + 4;
+  }
+
