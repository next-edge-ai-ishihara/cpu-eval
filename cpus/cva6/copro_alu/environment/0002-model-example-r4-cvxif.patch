+    insns.push_back((insn_desc_t){0x4b, 0x0600707f, &r4_arithmetic, &r4_arithmetic, &r4_arithmetic, &r4_arithmetic, &r4_arithmetic, &r4_arithmetic, &r4_arithmetic, r4_arithmetic});
