@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+package vexriscv.plugin
+
+import spinal.core._
+import vexriscv._
+
+case class CsrObservationSignals() extends Bundle {
+  val waitingForInterrupt = Bool()
+  val interruptAccepted = Bool()
+  val interruptCause = UInt(4 bits)
+  val exceptionAccepted = Bool()
+}
+
+trait CsrObservationService {
+  def csrObservation: CsrObservationSignals
+}
+
+class CsrObservationExportPlugin extends Plugin[VexRiscv] {
+  override def build(pipeline: VexRiscv): Unit = {
+    val observation = pipeline.service(classOf[CsrObservationService]).csrObservation
+    val pins = out(CsrObservationSignals()).setName("cpuEvalCsrObservation")
+    pins := observation
+  }
+}
