#!/bin/sh
#PJM -L rscgrp=a-batch
#PJM -L vnode-core=32
#PJM -L elapse=06:00:00
#PJM -L jobenv=singularity
#PJM -j

set -eu

: "${PJM_BULKNUM:?submit this script with pjsub --bulk}"
bundle_root=${CPU_EVAL_JOB_ROOT:-$PWD}

# A-node /tmp has a user quota independent of df's free-space report.
if [ -n "${CPU_EVAL_STAGE_ROOT:-}" ]; then
  stage_root=$CPU_EVAL_STAGE_ROOT
elif [ -n "${PJM_SSD_DIR:-}" ]; then
  stage_root=$PJM_SSD_DIR
else
  stage_root=
fi
if [ -n "$stage_root" ]; then
  export CPU_EVAL_STAGE_ROOT="$stage_root"
  export TMPDIR="$stage_root/cpu-eval-module-tmp"
  mkdir -p "$TMPDIR"
fi
module load singularity-ce
module load python/3.12.11
if [ -z "$stage_root" ]; then
  cpu=$(python3.12 -c 'import json,sys; print(json.load(open(sys.argv[1]))["cpu"])' "$bundle_root/evaluation-job.json")
  group_share="${HOME%/*}/share/$USER"
  if [ ! -d "$group_share" ]; then
    group_share=
  fi
  if [ "$cpu" = cva6 ] && [ -n "$group_share" ]; then
    work_root=$group_share
  elif [ -n "${TMPDIR:-}" ]; then
    work_root=$TMPDIR
  elif [ -n "$group_share" ]; then
    work_root=$group_share
  else
    work_root="$bundle_root/work"
  fi
  exec python3.12 "$bundle_root/repo/tools/evaluation/run_evaluation_chunk.py" \
    --bundle "$bundle_root/evaluation-job.json" \
    --chunk "$PJM_BULKNUM" --job-id "${PJM_JOBID:-unknown}" \
    --work-root "$work_root"
fi
exec python3.12 - "$bundle_root" <<'PY'
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

root = Path(sys.argv[1]).resolve()
chunk = int(os.environ['PJM_BULKNUM'])
name = f'chunk-{chunk:03d}'
job = os.environ.get('PJM_JOBID', 'unknown')
scratch = Path(os.environ['CPU_EVAL_STAGE_ROOT'])
scratch = scratch.resolve()
if scratch == root or root in scratch.parents:
    raise ValueError('temporary directory must be outside the shared bundle')
scratch.mkdir(parents=True, exist_ok=True)
lock = (root / f'.{name}.stage.lock').open('a')
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
archive = root / 'archives' / f'{name}.tar.gz'
if archive.exists() or archive.with_name(f'{name}.sha256').exists():
    raise FileExistsError(f'existing result preserved: {archive}')

# Stage immutable inputs and the selected chunk's resumable records only.
inputs = [root / entry for entry in ('evaluation-job.json', 'bundle-files.sha256',
                                    'repo', 'submissions', 'chunks', 'assets')
          if (root / entry).exists()]
prior = root / 'results' / name
if prior.exists():
    inputs.append(prior)
def input_bytes(path):
    if path.is_symlink():
        raise ValueError(f'input symlinks are not portable staging inputs: {path}')
    if path.is_file():
        return path.stat().st_size
    return sum(input_bytes(child) for child in path.iterdir())
size = sum(input_bytes(path) for path in inputs)
limit = int(os.environ.get('CPU_EVAL_STAGE_MAX_BYTES', str(16 * 1024**3)))
reserve = int(os.environ.get('CPU_EVAL_STAGE_RESERVE_BYTES', str(1024**3)))
if limit < 1 or reserve < 0 or size > limit:
    raise ValueError(f'staging inputs require {size} bytes; limit is {limit}')
free = shutil.disk_usage(scratch).free
if size + reserve > free:
    raise OSError(f'staging needs {size} input bytes plus {reserve} reserve; {free} free')
stage = Path(tempfile.mkdtemp(prefix=f'cpu-eval-{chunk:03d}-', dir=scratch))
staged = stage / 'bundle'
staged.mkdir()
process = None
interrupted = None
def receive_signal(number, frame):
    global interrupted
    interrupted = number
for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(number, receive_signal)

def publish(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.' + destination.name + '-', dir=destination.parent)
    try:
        with os.fdopen(fd, 'wb') as target, source.open('rb') as stream:
            shutil.copyfileobj(stream, target)
            target.flush()
            os.fsync(target.fileno())
        os.link(temporary, destination)
    finally:
        os.unlink(temporary)

def stop_tree(pid):
    for number in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, number)
        except ProcessLookupError:
            pass
        if number == signal.SIGTERM:
            time.sleep(2)

status = 2
published = False
try:
    for source in inputs:
        target = staged / source.relative_to(root)
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, target)
        else:
            shutil.copy2(source, target)
        if interrupted:
            raise InterruptedError('interrupted while staging inputs')
    # Keep the original image location and external_assets references unchanged.
    manifest = json.loads((staged / 'evaluation-job.json').read_text())
    image = Path.home() / 'cpu-eval-grading-images' / manifest['image']
    command = [sys.executable, str(staged / 'repo/tools/evaluation/run_evaluation_chunk.py'),
               '--bundle', str(staged / 'evaluation-job.json'), '--chunk', str(chunk),
               '--job-id', job, '--image', str(image), '--work-root', str(stage / 'work')]
    with (staged / 'stage-runner.log').open('wb') as log:
        process = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        while process.poll() is None:
            if interrupted:
                stop_tree(process.pid)
                break
            time.sleep(0.2)
        status = process.wait()
    completed = staged / 'archives' / f'{name}.tar.gz'
    checksum = staged / 'archives' / f'{name}.sha256'
    if not interrupted and completed.is_file() and checksum.is_file():
        expected = checksum.read_text().split()[0]
        digest = hashlib.sha256()
        with completed.open('rb') as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b''):
                digest.update(block)
        if digest.hexdigest() != expected:
            raise ValueError('completed archive checksum mismatch')
        publish(completed, archive)
        publish(checksum, archive.with_name(f'{name}.sha256'))
        published = True
    elif not interrupted and status == 0:
        raise RuntimeError('runner exited successfully without a completed archive and checksum')
finally:
    if process is not None and process.poll() is None:
        stop_tree(process.pid)
        process.wait()
    if stage.exists():
        # Retain incomplete records under a unique name; never overwrite prior runs.
        recovery = root / 'recoveries' / name / stage.name
        if not published:
            recovery.parent.mkdir(parents=True, exist_ok=True)
            temporary = recovery.with_name('.' + recovery.name)
            shutil.copytree(staged, temporary, ignore=shutil.ignore_patterns('repo', 'submissions', 'chunks', 'assets'))
            os.rename(temporary, recovery)
            print(f'Partial records retained: {recovery}', file=sys.stderr)
        if not interrupted:
            shutil.rmtree(stage)
        else:
            print(f'Interrupted work left for scheduler cleanup: {stage}', file=sys.stderr)
if interrupted:
    sys.exit(128 + interrupted)
sys.exit(status)
PY
